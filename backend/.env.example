# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env con secretos al repositorio.

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://usuario:password@localhost:5432/pistolet

# Secreto para firmar los JWT (usa una cadena larga y aleatoria).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esta_cadena_por_una_larga_y_aleatoria

# Puerto del servidor
PORT=3000

# --- Cloudinary (fotos de perfil) ---
# Crea una cuenta gratis en https://cloudinary.com y copia estos tres
# valores desde el Dashboard. Si no se configuran, las rutas de subida de
# foto de perfil responden 503 (el resto de la API funciona igual).
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret